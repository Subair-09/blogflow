# MONGODB_URI: MongoDB connection string (e.g. mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority)
# AI Studio automatically injects this at runtime from user secrets or environment.
MONGODB_URI=
MONGODB_DB_NAME=blogflow

# CLOUDINARY: Cloud storage credentials for uploading blog cover images and media
# You can provide either CLOUDINARY_CLOUD_NAME + CLOUDINARY_API_KEY + CLOUDINARY_API_SECRET
# OR provide a single CLOUDINARY_URL (e.g. cloudinary://api_key:api_secret@cloud_name)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=
